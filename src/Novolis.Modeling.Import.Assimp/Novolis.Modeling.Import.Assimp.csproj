<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Modeling.Import.Assimp</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Assimp-based FBX, OBJ, and glTF import/export for Novolis.Math.Geometry meshes. Native Assimp runtime required.</Description>
    <RootNamespace>Novolis.Modeling</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssimpNet" />
    <LibraryReference Include="Novolis.Math.Geometry" />
  </ItemGroup>
</Project>
